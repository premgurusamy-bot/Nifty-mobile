# Copy to server/.env and fill in. Never commit server/.env.

# --- Dhan (web.dhan.co → Profile → DhanHQ Trading APIs) ---
DHAN_CLIENT_ID=
# Access tokens expire (typically 24 h) — paste a fresh one and restart when the dashboard says the token expired.
DHAN_ACCESS_TOKEN=

# --- App ↔ server ---
# Long random secret the phone app must send. Generate one with:  openssl rand -hex 24
APP_API_KEY=
PORT=8787
HOST=0.0.0.0

# --- Orders ---
# false (default): the engine signals and paper-tracks; the Portfolio/Orders tabs paper-trade on live prices.
# true: the order ticket can place REAL orders on your Dhan account (confirmation required in the app).
# Dhan only accepts order APIs from your whitelisted static IP — run the server there.
LIVE_ORDERS=false
# Reject single orders above this notional (₹). 0 = no limit.
MAX_ORDER_VALUE=200000

# --- Alerts (optional, same as the workbook's Telegram settings) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
# Engine state: journal, IV history, open position, daily counters.
DATA_DIR=server/data
